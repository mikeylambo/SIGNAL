# Copy this file to .env and fill in your Supabase project credentials.
# Get these from: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: anonymous crash/usage telemetry endpoint (POST, JSON body).
# Leave blank to disable telemetry entirely — with no value set, the whole
# subsystem is inert and the Diagnostics toggle is hidden. See src/telemetry.ts.
VITE_TELEMETRY_URL=

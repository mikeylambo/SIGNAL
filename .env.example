# Copy this file to .env and fill in your Supabase project credentials.
# Get these from: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: anonymous crash/usage telemetry endpoint (POST, JSON body).
# Leave blank to disable telemetry entirely — with no value set, the whole
# subsystem is inert and the Diagnostics toggle is hidden. See src/telemetry.ts.
VITE_TELEMETRY_URL=

# Optional: Cloudflare Turnstile site key. Leave blank and attestation is fully
# inert — nothing is loaded from Cloudflare and identities are claimed as before.
# Enabling it takes three steps, in this order, or new players get locked out:
#   1. set this, and deploy the client
#   2. supabase functions deploy verify-attestation
#      supabase secrets set TURNSTILE_SECRET_KEY=<your secret key>
#   3. only then, in SQL:
#      update app_settings set value = 'true' where key = 'require_attestation';
# Cloudflare's always-passes test key is 1x00000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=
